# ArchAI Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional External AI Provider Key (Leave empty to use deterministic procedural engine)
# ArchAI automatically detects this key. If omitted or invalid, it gracefully falls back
# to the deterministic multilingual architectural rule engine without crashing.
GEMINI_API_KEY=your_gemini_api_key_here
